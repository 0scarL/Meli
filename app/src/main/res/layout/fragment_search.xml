<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:padding="15dp"
    android:fitsSystemWindows="true"
    card_view:cardCornerRadius="12dp"
    card_view:cardElevation="6dp"
    tools:context=".ui.view.search.SearchFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="200dp">

        <TextView
            android:id="@+id/tv_search_indication"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Realice la busqueda de productos..."
            android:textAlignment="center"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            card_view:layout_constraintBottom_toTopOf="@id/edit_text_search"
            card_view:layout_constraintEnd_toEndOf="parent"
            card_view:layout_constraintStart_toStartOf="parent"
            card_view:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/edit_text_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/shadow_searcher"
            android:padding="10dp"
            android:textCursorDrawable="@drawable/cursor_white"
            android:textColor="@color/white"
            android:layout_marginEnd="5dp"
            android:focusableInTouchMode="true"
            card_view:layout_constraintBottom_toBottomOf="parent"
            card_view:layout_constraintEnd_toStartOf="@id/imageView_buscar"
            card_view:layout_constraintStart_toStartOf="parent"
            card_view:layout_constraintTop_toBottomOf="@id/tv_search_indication" />

        <ImageView
            android:id="@+id/imageView_buscar"
            android:layout_width="55dp"
            android:layout_height="0dp"
            android:background="@drawable/shadow_serch"
            android:scaleType="centerCrop"
            android:layout_marginEnd="5dp"
            android:src="@drawable/ic_search_selector"
            card_view:layout_constraintBottom_toBottomOf="@id/edit_text_search"
            card_view:layout_constraintStart_toEndOf="@id/edit_text_search"
            card_view:layout_constraintEnd_toEndOf="parent"
            card_view:layout_constraintTop_toTopOf="@id/edit_text_search" />


    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.cardview.widget.CardView>